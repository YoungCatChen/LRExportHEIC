{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "swift",
      "request": "launch",
      "name": "Debug ConvertToHeic",
      "target": "ConvertToHeic",
      "configuration": "debug",
      "cwd": "${workspaceFolder}",
      "args": [
        "${input:outputImage}",
        "--input-file",
        "${input:inputImage}",
        "--quality",
        "0.9",
        "--verbose"
      ],
      "preLaunchTask": "swift: Build Debug ConvertToHeic"
    },
    {
      "type": "swift",
      "request": "launch",
      "name": "Debug HDR image inspection",
      "target": "hdr-image-tool",
      "configuration": "debug",
      "cwd": "${workspaceFolder}",
      "args": [
        "inspect",
        "${input:inputImage}"
      ],
      "preLaunchTask": "swift: Build Debug hdr-image-tool"
    },
    {
      "type": "swift",
      "request": "launch",
      "name": "Debug HDR image comparison",
      "target": "hdr-image-tool",
      "configuration": "debug",
      "cwd": "${workspaceFolder}",
      "args": [
        "compare",
        "--rendition",
        "${input:rendition}",
        "${input:inputImage}",
        "${input:referenceImage}"
      ],
      "preLaunchTask": "swift: Build Debug hdr-image-tool"
    }
  ],
  "inputs": [
    {
      "id": "inputImage",
      "type": "promptString",
      "description": "Input image path"
    },
    {
      "id": "referenceImage",
      "type": "promptString",
      "description": "Reference image path"
    },
    {
      "id": "outputImage",
      "type": "promptString",
      "description": "Output HEIC path"
    },
    {
      "id": "rendition",
      "type": "pickString",
      "description": "Rendition to compare",
      "options": [
        "auto",
        "sdr",
        "hdr",
        "both"
      ],
      "default": "auto"
    }
  ]
}
